<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Sweepling</RootNamespace>
    <AssemblyName>Sweepling</AssemblyName>
    <!-- Shown by Windows as the file description, e.g. in Task Manager. -->
    <AssemblyTitle>Sweepling</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\docs\brand\sweepling.ico</ApplicationIcon>
    <!-- One native process with no JIT: the idle ceiling depends on it (see ROADMAP.md). -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Report each trim warning where it comes from instead of one per assembly. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Sweepling ships for x64 only, as its PEB offsets assume; NOTIFYICONDATAW is laid out per architecture. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\docs\brand\sweepling.ico" Link="Assets\sweepling.ico" />
    <EmbeddedResource Include="Leftovers\rules.json" LogicalName="Sweepling.rules.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sweepling.Tests" />
  </ItemGroup>

</Project>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sweepling.Review"
        x:Class="Sweepling.Review.ReviewWindow"
        x:DataType="vm:ReviewViewModel"
        Title="Sweepling"
        Icon="/Assets/sweepling.ico"
        Width="560" Height="620" MinWidth="440" MinHeight="360"
        WindowStartupLocation="Manual"
        Background="{DynamicResource SurfaceBrush}">
  <Window.Resources>
    <DataTemplate x:Key="GroupTemplate" x:DataType="vm:GroupRow">
      <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
          <CheckBox Grid.RowSpan="2" VerticalAlignment="Top" Margin="0,-4,4,0"
                    IsChecked="{Binding IsChecked}"
                    AutomationProperties.Name="{Binding What}" />
          <TextBlock Grid.Column="1" Text="{Binding What}" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Text="{Binding Memory}" FontSize="13" Margin="12,0,0,0"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Summary}" FontSize="13" Margin="0,4,0,0"
                     Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
          <Expander Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                    Header="{Binding ProcessesLabel}">
            <ItemsControl ItemsSource="{Binding Processes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProcessRow">
                  <SelectableTextBlock Text="{Binding Line}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2" Foreground="{DynamicResource TextBrush}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="24,20,24,12" Spacing="4">
      <TextBlock Text="{Binding Heading}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
      <TextBlock Text="Ticked groups close together when you press Close. Nothing closes without it."
                 FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource SurfaceRaisedBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Done" IsCancel="True" Click="OnDone" />
          <Button Classes="close" Content="{Binding CloseLabel}" Command="{Binding CloseCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{DynamicResource TextMutedBrush}" />
      </DockPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="24,0,24,16" Spacing="16">
        <StackPanel IsVisible="{Binding HasLeftovers}" Spacing="8">
          <StackPanel Spacing="2">
            <TextBlock Text="Leftovers" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="From Claude Code sessions that have ended." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Leftovers}" ItemTemplate="{StaticResource GroupTemplate}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding HasStillRunning}" Spacing="8">
          <StackPanel Spacing="2">
            <TextBlock Text="Session still running" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="Their session may still need them, so none is ticked." FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource CautionBrush}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding StillRunning}" ItemTemplate="{StaticResource GroupTemplate}" />
        </StackPanel>

        <TextBlock IsVisible="{Binding IsEmpty}" Margin="0,24,0,0" FontSize="14" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Text="Nothing to sweep. Sweepling looks again every 5 seconds." />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
